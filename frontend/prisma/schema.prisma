// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdWorkspaces Workspace[]
  agentPrompts AgentPrompt[]

}

enum WorkSpaceStatus{
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Workspace{
  id String      @id @default(cuid())
  name String
  description String?
  creatorId String 
  creator User      @relation(fields: [creatorId] ,references: [id], onDelete: Cascade)
  clerkOrgId String?

  status WorkSpaceStatus  @default(PLANNING)
  position Float @default(0)

  shareToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doc  Doc?
  canvas Canvas?
  agentPrompts AgentPrompt[]

  @@index([creatorId])
  @@index([clerkOrgId])

}

model Doc{
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // BlockNote block JSON — a readable copy for server-side features (agent, share view).
  content     Json?
  // Yjs document state — the real-time collaboration source of truth.
  yjsState    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Canvas{
 id          String   @id @default(cuid())
  workspaceId String   @unique
  // tldraw shape/store snapshot.
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentPrompt {
id          String   @id @default(cuid())
  // Who the prompt counts against: the workspace's Clerk org id, or the Clerk user id for a
  // personal workspace. Clerk prefixes ids ("org_", "user_"), so the two never collide.
  ownerId     String
  userId      String
  workspaceId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}
